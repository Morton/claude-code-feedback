{
  "name": "claude-code-feedback",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Comment on your local web app and feed the feedback into your Claude Code session via MCP.",
  "license": "MIT",
  "author": "Martin Heller",
  "homepage": "https://github.com/Morton/claude-code-feedback#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morton/claude-code-feedback.git"
  },
  "bugs": {
    "url": "https://github.com/Morton/claude-code-feedback/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "feedback",
    "screenshot",
    "developer-tools",
    "widget"
  ],
  "bin": {
    "claude-feedback-bridge": "dist/bridge.js"
  },
  "scripts": {
    "build:widget": "esbuild src/widget/widget.ts --bundle --format=iife --outfile=public/widget.js --target=es2020",
    "build:bridge": "esbuild src/bridge.ts --bundle --platform=node --format=esm --outfile=dist/bridge.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build": "pnpm run build:widget && pnpm run build:bridge",
    "build:plugin": "pnpm run build && rm -rf plugin/dist plugin/public && mkdir -p plugin/dist plugin/public && cp dist/bridge.js plugin/dist/bridge.js && cp public/widget.js public/demo.html plugin/public/",
    "start": "node dist/bridge.js",
    "dev": "tsx src/bridge.ts",
    "example": "node example/serve.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@medv/finder": "^4.0.2",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "html2canvas": "^1.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.34.1+sha512.b58fbde6dca66a929538021581f648b4570b6ca19b18e7cbd7f2c07a7b24454155388dacdf08f2af3678e88a6d1fe04f9d609df24bf51735a060ea041b374ab7"
}
